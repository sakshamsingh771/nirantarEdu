# Copy this file to .env for CLOUD deployment:
# frontend -> cloud backend -> MongoDB Atlas
#                            -> Ollama running on a cloud VM/server -> Llama
#
# The frontend never talks to Ollama directly in either deployment mode —
# only the backend does. Do not expose the Ollama port publicly.

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string. Get this from Atlas -> Connect -> Drivers.
# NEVER commit the real value — this is a placeholder only.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nirantaredu?retryWrites=true&w=majority

# JWT — generate a long random value, e.g. `openssl rand -hex 32`.
# NEVER reuse the local dev secret in production.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_PRODUCTION_SECRET
JWT_EXPIRES_IN=7d

# The public URL(s) of your deployed frontend. Comma-separated if you serve
# more than one (e.g. a staging and a production URL). CORS will reject any
# other origin — see server.js. Do NOT use "*" here.
FRONTEND_URL=https://app.yourschool.org

# Hybrid AI: with internet + AI_API_KEY configured, cloud AI is tried first
# for every Nirantar AI request; Ollama is used automatically as a fallback
# on any cloud failure (timeout, rate limit, 5xx, connection failure), and
# as the sole provider if AI_API_KEY is left blank. Conversation history
# survives a fallback automatically — see server/src/services/aiService.js.
AI_PROVIDER=auto
# Cloud provider is Gemini by default (server/src/services/aiProviders/cloudProvider.js).
# NEVER commit the real key — this is a placeholder only.
AI_API_KEY=REPLACE_WITH_YOUR_CLOUD_AI_API_KEY
AI_MODEL=gemini-2.0-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta   # override only if swapping providers
# AI_CLOUD_TIMEOUT_MS=12000   # how long to wait on the cloud provider before falling back to Ollama

# Ollama running on a cloud Linux VM/server, reachable only from the backend
# (e.g. same private network/VPC, or behind a firewall that only allows the
# backend's IP). Never point a browser at this URL directly.
OLLAMA_BASE_URL=http://<ollama-vm-private-ip>:11434
NIRANTAR_AI_MODEL=llama3.2

# Generation capacity — same meaning as local; a cloud VM sized for this
# workload can usually afford the same defaults or slightly higher.
NIRANTAR_AI_NUM_CTX=4096
NIRANTAR_AI_NUM_PREDICT=1024
NIRANTAR_AI_NUM_PREDICT_STRUCTURED=2048

# Uploads. In the cloud, /app/uploads inside the backend container must be
# backed by persistent storage (a cloud disk/volume, or object storage
# mounted as a filesystem) — see docker-compose.cloud.yml — otherwise
# materials are lost on every container restart/redeploy.
MAX_UPLOAD_MB=50
