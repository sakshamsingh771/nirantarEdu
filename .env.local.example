# Copy this file to .env for LOCAL / OFFLINE deployment (docker-compose.yml):
# frontend -> backend -> local MongoDB (in Docker) -> local Ollama (on host).
# For a cloud deployment, use .env.production.example instead.

NODE_ENV=production
PORT=5000

# Mongo (used by backend when running outside docker, docker-compose overrides this)
MONGO_URI=mongodb://nirantar:nirantar_local_pw@localhost:27017/nirantaredu?authSource=admin

# JWT
JWT_SECRET=change_this_to_a_long_random_local_secret
JWT_EXPIRES_IN=7d

# Ollama (local AI, no internet required after model pull).
# Ollama is expected to already be installed and running on the HOST
# machine, not as a Docker container. When the backend runs inside Docker
# Compose, host.docker.internal is how it reaches the host:
OLLAMA_BASE_URL=http://host.docker.internal:11434
# When running the backend directly with `npm run dev` (no Docker), use:
# OLLAMA_BASE_URL=http://localhost:11434

# The local model to use for every Nirantar AI feature (chat, summarize,
# quiz/assignment generation). Not hard-coded anywhere in the app — pick a
# smaller/faster model on limited hardware, e.g. "llama3.2:1b" or "phi3".
# OLLAMA_MODEL is still read as a fallback if NIRANTAR_AI_MODEL isn't set.
NIRANTAR_AI_MODEL=llama3.2

# Hybrid AI provider selection. In local/offline deployment this stays
# "ollama" so the cloud provider is never even attempted — see
# .env.production.example for the cloud-enabled configuration. Regardless of
# this setting, Ollama itself is always available as the fallback; the only
# thing AI_PROVIDER controls is whether the cloud path is tried FIRST.
AI_PROVIDER=ollama
# AI_API_KEY=            # left unset locally — cloud is not used in this mode
# AI_MODEL=gemini-2.0-flash

# Generation capacity — raise on a stronger server, lower on modest hardware.
# NUM_CTX is the model's total context window (prompt + reply, in tokens).
# NUM_PREDICT is the max reply length for chat. NUM_PREDICT_STRUCTURED is the
# max length for quiz/assignment JSON generation (scales down automatically
# for small question counts, capped at this value for large ones).
NIRANTAR_AI_NUM_CTX=4096
NIRANTAR_AI_NUM_PREDICT=1024
NIRANTAR_AI_NUM_PREDICT_STRUCTURED=2048

# Uploads
MAX_UPLOAD_MB=50

# CORS — left unset on purpose for local dev: with no FRONTEND_URL, the
# server allows any origin (fine on a trusted school LAN). Set this if you
# do want to lock it down even locally, same format as the production file.
# FRONTEND_URL=http://localhost:80
